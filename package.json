{
  "name": "kram.land",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "oxlint",
    "check": "npm run tokens && cmk && astro check && npm run check --workspaces --if-present",
    "preview": "astro preview",
    "knip": "knip",
    "format": "prettier --check .",
    "verify": "npm run format && npm run lint && npm run lint:css && npm run check && npm run knip && npm test && npm run build",
    "lint:css": "npm run tokens && stylelint \"src/**/*.css\"",
    "tokens": "token-jet generate && token-jet-generate",
    "prebuild": "npm run tokens",
    "test": "vitest run && npm test --workspaces --if-present",
    "predev": "npm run tokens",
    "prepare": "npm run build --workspaces --if-present && npm run tokens"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.3",
    "classnames": "^2.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "the-new-css-reset": "^1.11.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@css-modules-kit/codegen": "^1.4.0",
    "@types/node": "24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^6.37.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "token-jet": "*",
    "token-jet-generate": "*",
    "token-jet-lsp": "*",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
