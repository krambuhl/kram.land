{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "components/*": ["./src/components/*"],
      "layouts/*": ["./src/layouts/*"],
      "types/*": ["./src/types/*"],
      "utilities/*": ["./src/utilities/*"],
      "generated/*": ["./generated/*"]
    },
    "rootDirs": [".", "generated"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "packages", "generated/*.module.css"],
  "cmkOptions": {
    "enabled": true,
    "dtsOutDir": "generated"
  }
}
