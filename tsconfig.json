{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "components/*": ["./src/components/*"],
      "layouts/*": ["./src/layouts/*"],
      "tokens": ["./src/tokens"],
      "types/*": ["./src/types/*"]
    },
    "rootDirs": [".", "generated"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "cmkOptions": {
    "enabled": true,
    "dtsOutDir": "generated"
  }
}
