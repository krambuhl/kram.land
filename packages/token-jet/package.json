{
  "name": "token-jet",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens from one typed config: CSS custom properties, TypeScript types, and a token() function for both.",
  "type": "module",
  "bin": {
    "token-jet": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "default": "./dist/postcss.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "tsdown",
    "test": "vitest run --typecheck",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "ajv": "^8.20.0",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "postcss": "^8.5.28"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ]
}
