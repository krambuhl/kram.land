{
  "$extensions": {
    "token-jet": {
      "modes": {
        "dark": "(prefers-color-scheme: dark)",
        "contrast": "(prefers-contrast: more)"
      }
    }
  },
  "space": {
    "x4": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$extensions": {
        "token-jet": {
          "preview": "gap"
        }
      }
    },
    "x16": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "The default gap.",
      "$extensions": {
        "token-jet": {
          "preview": "gap"
        }
      }
    }
  },
  "weight": {
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "family": {
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "sans-serif"
      ]
    }
  },
  "ratio": {
    "golden": {
      "$type": "number",
      "$value": 1.618,
      "$extensions": {
        "token-jet": {
          "inherits": false
        }
      }
    }
  },
  "gray": {
    "50": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9804,
          0.9804
        ],
        "hex": "#fafafa"
      }
    },
    "900": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0902,
          0.0902,
          0.0902
        ],
        "hex": "#171717"
      }
    }
  },
  "bg": {
    "page": {
      "$type": "color",
      "$value": "{gray.50}",
      "$extensions": {
        "token-jet": {
          "modes": {
            "dark": "{gray.900}"
          }
        }
      }
    },
    "card": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      },
      "$extensions": {
        "token-jet": {
          "modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [
                0.102,
                0.102,
                0.102
              ],
              "hex": "#1a1a1a"
            },
            "contrast": {
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ],
              "hex": "#000000"
            }
          }
        }
      }
    }
  },
  "content": {
    "regular": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.0667,
          0.0667
        ],
        "hex": "#111111"
      },
      "$deprecated": "use content.body",
      "$extensions": {
        "token-jet": {
          "modes": {
            "dark": {
              "colorSpace": "srgb",
              "components": [
                0.9333,
                0.9333,
                0.9333
              ],
              "hex": "#eeeeee"
            }
          }
        }
      }
    },
    "body": {
      "$type": "color",
      "$value": "{content.regular}"
    }
  }
}