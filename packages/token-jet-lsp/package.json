{
  "name": "token-jet-lsp",
  "version": "0.0.0",
  "private": true,
  "description": "A language server for token() calls: completion, hover and diagnostics from tokens.config.ts.",
  "type": "module",
  "bin": {
    "token-jet-lsp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/analyze.d.ts",
      "default": "./dist/analyze.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "tsdown",
    "test": "vitest run --typecheck",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "token-jet": "*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "files": [
    "dist"
  ]
}
