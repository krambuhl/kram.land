{
  "name": "token-jet-generate",
  "version": "0.0.0",
  "private": true,
  "description": "Token-indexed generation: select tokens, map each through a template, aggregate the fragments into files.",
  "type": "module",
  "bin": {
    "token-jet-generate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "tsdown",
    "test": "vitest run --typecheck",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "token-jet": "*"
  },
  "files": [
    "dist"
  ]
}
