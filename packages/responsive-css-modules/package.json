{
  "name": "responsive-css-modules",
  "version": "0.0.0",
  "private": true,
  "description": "Responsive variants of CSS Module classes, at token-jet breakpoints, emitted only where used.",
  "bin": {
    "responsive-css-modules": "./bin/responsive-css-modules.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./token-jet": {
      "types": "./dist/token-jet.d.ts",
      "default": "./dist/token-jet.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "tsdown",
    "test": "vitest run --typecheck",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "postcss": "^8.5.28",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "token-jet": "*",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "token-jet": "*",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "token-jet": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
