---
import type { Align } from 'types/common';
import type { SizeToken } from 'types/tokens';

import styles from './Stack.module.css';

interface Props {
  align?: Align;
  gap?: SizeToken;
}

const { align, gap } = Astro.props;
---

<div
  class:list={[styles.root, { [styles.alignCenter]: align === 'center', [styles.alignEnd]: align === 'end' }]}
  style={gap && `--stack-gap: ${gap}`}
>
  <slot />
</div>
