---
import type { FontVariant, Size } from 'types/common';
import { tokens } from 'tokens';

import styles from './Text.module.css';

interface Props {
  as?: 'div' | 'p' | 'span' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  variant?: FontVariant;
  size?: Size;
}

const { as: Tag = 'div', variant = 'body', size = 'md' } = Astro.props;
---

<Tag
  class:list={[styles.root, { [styles.variantHeading]: variant === 'heading' }]}
  style={`--text-font-size: ${tokens.fontSize[variant][size]}`}
>
  <slot />
</Tag>
