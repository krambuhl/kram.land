---
import { getImage } from 'astro:assets';

import { Mode } from 'components/mode';
import { PageContainer } from 'components/page-container';
import ikea from '../assets/ikea.png';

import '../styles/globals.css';

import type { ModeValue } from 'components/mode';

interface Props {
  immersive?: boolean;
  mode?: ModeValue;
}

const { immersive = false, mode = 'auto' } = Astro.props;

const title = 'kram.land';
const description = 'making internet with the nice people who live there';
const url = 'https://kram.land';
const social = await getImage({ src: ikea, width: 960, height: 504, fit: 'cover', position: 'center', format: 'jpg' });
const image = new URL(social.src, Astro.site).href;
---

<!doctype html>
<html lang="en" data-backdrop={immersive ? 'art' : undefined}>
  <head>
    <meta charset="utf-8" />
    {immersive && <script is:inline>
      document.documentElement.setAttribute('data-immersive', '');
    </script>}
    <meta name="viewport" content={`width=device-width, initial-scale=1${immersive ? ', viewport-fit=cover' : ''}`} />
    {immersive && <meta name="theme-color" content="#000" />}
    {immersive && <meta name="apple-mobile-web-app-capable" content="yes" />}
    {immersive && <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={title} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={social.attributes.width} />
    <meta property="og:image:height" content={social.attributes.height} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Mode value={mode}>
      <PageContainer>
        <slot />
      </PageContainer>
    </Mode>
  </body>
</html>
