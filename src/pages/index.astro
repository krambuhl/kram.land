---
import { getImage } from 'astro:assets';

import Layout from 'layouts/Layout.astro';
import { Home } from 'views/home';
import ikea from '../assets/ikea.png';

const image = await getImage({ src: ikea, width: 192, height: 192, densities: [1, 2, 3] });
const photo = { src: image.src, srcSet: image.srcSet.attribute, width: 192, height: 192 };
---

<Layout>
  <Home photo={photo} />
</Layout>
