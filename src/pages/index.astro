---
import { Image } from 'astro:assets';

import { Rule } from 'components/rule';
import Layout from 'layouts/Layout.astro';
import { token } from 'generated/tokens';
import { area } from 'utilities/area';
import { entrance } from 'utilities/entrance';
import { secret } from 'utilities/secret';
import { stack } from 'utilities/stack';
import { superellipse } from 'utilities/superellipse';
import { bodyText, headingText } from 'utilities/text';
import ikea from '../assets/ikea.png';
---

<Layout>
  <div
    data-secret-root
    class:list={[
      area({ width: token('size.x384') }),
      stack({ gap: token('space.x48'), align: 'center' }),
      secret({ part: 'root' }),
    ]}
  >
    <Image
      src={ikea}
      alt=""
      width={192}
      height={192}
      densities={[1, 2, 3]}
      priority
      data-secret-image
      class:list={[superellipse(), entrance({ motion: 'rise' }), secret({ part: 'image' })]}
    />

    <div
      data-secret-text
      class:list={[
        stack({ gap: token('space.x24'), align: 'center' }),
        entrance({ motion: 'rise', order: 'second', stagger: true }),
        secret({ part: 'text' }),
      ]}
    >
      <h1 class={headingText({ size: 'xl' })}>oh hi. hello!</h1>

      <p class={bodyText()}>
        i’m <strong>evan krambuhl</strong> and i make <strong>internet</strong> with real nice people at{' '}
        <strong>patreon</strong>
      </p>

      <p class={bodyText()}>
        i specialize in <strong>high quality ui</strong> and <strong>thoughtful patterns</strong> to help developers to
        be more productive
      </p>

      <p class={bodyText()}>
        an <abbr title="read: never owned an unbrella">oregon</abbr> native, you'll find me outdoorsing and swimming in
        the rivers when they're not mountain runoff
      </p>

      <p class={bodyText()}>
        i love making <a href="https://www.instagram.com/ev.aart">generative art</a> and playing drums and have an
        endless appetite for live music and <abbr title="one must imagine sisyphus happy">absurdity</abbr>
      </p>

      <Rule />

      <p class={bodyText({ size: 'sm' })}>
        say hello: <a href="mailto:evan.krambuhl@gmail.com">email</a>
      </p>

      <p class={bodyText({ size: 'xs' })}>
        * i’m a busy hotdog,
        <br />
        please be nice
      </p>
    </div>
  </div>
</Layout>

<script>
  import { secretScroll } from 'utilities/secret/script';

  const root = document.querySelector<HTMLElement>('[data-secret-root]');
  const image = document.querySelector<HTMLElement>('[data-secret-image]');
  const text = document.querySelector<HTMLElement>('[data-secret-text]');
  if (root && image && text) secretScroll(root, image, text);
</script>
