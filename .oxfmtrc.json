{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.astro",
    "packages/*/test/__snapshots__/",
    "packages/*/dist/",
    "packages/token-jet-zed/target/"
  ]
}
